{
    "manifest_version": 3,
    "name": "Dino Hack Panel",
    "version": "1.0",
    "description": "Hack Chrome Dino Game - Auto Jump, Speed, No Death!",
    "permissions": ["scripting"],
    "host_permissions": ["<all_urls>"],
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "run_at": "document_idle"
      }
    ],
    "icons": {
      "128": "icons/icon128.png"
    }
  }
  